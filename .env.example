# Copy this file to .env and change the values:
#   cp .env.example .env
# .env is ignored by Git, so your real password stays on your machine.

# the two options people vote between
OPTION_A=Kampala
OPTION_B=Entebbe

# PostgreSQL login used by db, worker and result
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-something-long
